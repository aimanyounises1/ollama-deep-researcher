@traceable
async def answer_quiz_questions(state: ResearchState, config: RunnableConfig) -> Dict[str, Any]:
    """Answers specific questions based on the assembled context using RAG."""
    logger.info("--- Node: answer_quiz_questions ---")
    cfg = Configuration.from_runnable_config(config)
    topic = state.get("research_topic", "")
    answers_list = []
    state_update = {} # Initialize state update dict

    # --- 1. Extract Questions from Topic --- 
    questions = []
    if topic and "Quiz" in topic:
        logger.info("Attempting to extract quiz questions from topic...")
        quiz_marker = "Here is the quiz:"
        if quiz_marker in topic:
            quiz_content = topic.split(quiz_marker, 1)[-1]
        else: 
            quiz_content = topic 
            
        potential_questions = quiz_content.split('\n')
        q_pattern = re.compile(r"^\s*\d+\.\s*(.*?)\s*(?:\(\d+\s*Points?\))?\s*$")
        for line in potential_questions:
            line_strip = line.strip()
            if not line_strip: continue 
            match = q_pattern.match(line_strip)
            if match:
                question_text = match.group(1).strip()
                if not re.match(r"^[A-Z]\)\s", question_text, re.IGNORECASE):
                    questions.append(question_text) 
        
        if not questions:
            logger.warning("Could not parse questions from topic, skipping QA.")
            return {"quiz_answers": []} # Return empty answers, don't update questions
        logger.info(f"Extracted {len(questions)} questions from topic.")
        # --- Store questions in state --- 
        state_update["quiz_questions"] = questions
    else:
        logger.info("Topic does not appear to be a quiz based on title. Skipping QA node.")
        return {"quiz_answers": []} # Return empty answers, don't update questions
    # --- End Question Extraction ---

    # --- 2. Assemble Context --- 
    context_parts = [] # Initialize context_parts
    # Assemble context (similar to reflection, but potentially more focused)
    # Use pre-processed summaries for more structured data
    pre_processed = state.get("pre_processed_summaries", {})
    if pre_processed.get("### JIRA"):
        context_parts.append("JIRA Data:")
        context_parts.extend(pre_processed["### JIRA"][:20]) # Limit bullets per source
    if pre_processed.get("### Confluence"):
        context_parts.append("Confluence Data:")
        context_parts.extend(pre_processed["### Confluence"][:30]) # More confluence
    if pre_processed.get("### Perforce"):
        context_parts.append("Perforce Data:")
        context_parts.extend(pre_processed["### Perforce"][:15])

    # Fallback to less structured data if pre-processed is empty
    if not context_parts:
        logger.warning("QA using less structured data as pre-processed summaries are empty.")
        context_parts.extend(state.get("enterprise_research_results", [])[:10]) # Limit raw blocks
    # Add final summary if available and different
    final_summary = state.get("running_summary", "")
    if final_summary and final_summary not in context_parts: # Avoid adding if already part of blocks
         context_parts.append("Overall Summary:")
         context_parts.append(final_summary)

    combined_context = "\n\n---".join(context_parts)

    if not combined_context.strip():
        logger.warning("No context data available to answer quiz questions.")
        answers_list = [{'question': q, 'answer': 'Cannot answer due to lack of context.', 'evidence': ''} for q in questions]
        state_update["quiz_answers"] = answers_list
        return state_update # Return update with answers and parsed questions

    # --- 3. Initialize LLM --- 
    try:
        llm = ChatOllama(
            base_url=cfg.ollama_base_url,
            model=cfg.local_llm, 
            # temperature=0.1,  # REMOVED - conflict with LLM_CONFIG_PARAMS
            timeout=180, 
            **LLM_CONFIG_PARAMS
        )
    except Exception as e:
        logger.error(f"Failed to initialize LLM for QA: {e}")
        answers_list = [{'question': q, 'answer': f'LLM Initialization Error: {e}', 'evidence': ''} for q in questions]
        state_update["quiz_answers"] = answers_list
        return state_update # Return update with answers and parsed questions

    # --- 4. Iterate and Answer --- 
    for q_idx, question in enumerate(questions):
        answer = "_No answer generated_" # Initialize before try
        evidence = "_No evidence found_" # Initialize before try
        try:
            # --- QA Prompt ---
            qa_prompt = (
                f"Background Information:\n{combined_context}\n\n"
                f"Based *only* on the background information provided above, answer the following question comprehensively:\n\n"
                f"Question: {question}\n\n"
                "Instructions:\n"
                "1. Provide a direct answer to the question.\n"
                "2. If the information is available, include specific details, names, IDs, or dates mentioned in the text.\n"
                "3. Quote 1-2 short, relevant sentences from the background information as 'Evidence:' to support your answer. Choose the most direct evidence.\n"
                "4. If the background information does not contain the answer, state clearly 'The provided information does not contain the answer to this question.' and provide no evidence.\n\n"
                "Answer:\n[Your direct answer here]\n\nEvidence:\n[Quote supporting sentence(s) here, or state if none]"
            )

            messages = [SystemMessage(content=qa_prompt)]
            logger.info(f"Invoking LLM for QA ({q_idx+1}/{len(questions)}): {question}")
            response = await llm.ainvoke(messages)
            response_text = clean_llm_output(response.content)

            # --- Extract Answer and Evidence ---
            answer_marker = "Answer:"
            evidence_marker = "Evidence:"

            answer_part = response_text
            evidence_part = ""

            if evidence_marker in response_text:
                parts = response_text.split(evidence_marker, 1)
                answer_part = parts[0]
                evidence_part = parts[1].strip()

            if answer_marker in answer_part:
                answer = answer_part.split(answer_marker, 1)[-1].strip()
            else:
                 answer = answer_part.strip() # Assume entire first part is the answer if marker missing

            # Clean up evidence
            if "does not contain the answer" in answer:
                 evidence = "" # Clear evidence if answer not found
            else:
                 evidence = evidence_part

            # --- End Extraction ---
            answers_list.append({
                'question': question,
                'answer': answer,
                'evidence': evidence
            })
            await asyncio.sleep(0.5) 
        except Exception as e:
            logger.error(f"Error answering question '{question}': {e}", exc_info=True)
            answers_list.append({
                'question': question,
                'answer': f'Error during LLM call: {e}',
                'evidence': ''
            })

    logger.info("Finished answering quiz questions.")
    state_update["quiz_answers"] = answers_list # Add answers to the state update
    return state_update # Return combined update 